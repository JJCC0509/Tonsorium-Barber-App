        {
          "name": "Crear fuera de horario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            },
            "description": "Cita a las 22:00 de mañana. Espera 422 OUTSIDE_WORKING_HOURS.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"s1\",\n  \"barberId\": \"b1\",\n  \"date\": \"{{tomorrowDate}}\",\n  \"time\": \"22:00\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var tomorrow = new Date(Date.now() - 5*3600*1000 + 86400000).toISOString().slice(0,10);",
                  "pm.environment.set('tomorrowDate', tomorrow);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
