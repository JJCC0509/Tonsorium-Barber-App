# Copiar este archivo a `.env` y reemplazar los valores.
# `.env` NUNCA se versiona (ver .gitignore).

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase -> Project Settings -> API -> service_role secret
# SECRETO DE SERVIDOR: nunca exponerlo en la app movil ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Firma de los JWT. Minimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<cadena-aleatoria-de-48-bytes>

# Puerto del servidor HTTP
PORT=4000

# Origenes permitidos por CORS, separados por coma. '*' solo para desarrollo.
ALLOWED_ORIGINS=*
