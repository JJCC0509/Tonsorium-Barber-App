# Copiar este archivo a `.env` antes de arrancar la app.
# `.env` NUNCA se versiona (ver .gitignore).
#
# EXPO_PUBLIC_* se incrusta en el bundle en tiempo de compilacion:
# cambiar este valor exige reiniciar el servidor de desarrollo.
#
# Desarrollo en LAN (el telefono debe estar en la misma Wi-Fi que el PC):
#   EXPO_PUBLIC_API_URL=http://192.168.1.1:4000/api/v1
#
# Backend desplegado en Render (HTTPS, funciona en cualquier red):
EXPO_PUBLIC_API_URL=https://tonsorium-api.onrender.com/api/v1
